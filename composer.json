{
    "name": "enoch/charosdentalclinicemrsystem",
    "description": "Web-based EMR system for Charos Dental Clinic with appointment scheduling and e-prescriptions.",
    "type": "project",
    "authors": [
        {
            "name": "Enichh",
            "email": "enochastor@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "vlucas/phpdotenv": "^5.6",
        "php-di/php-di": "^7.0",
        "symfony/mailer": "*",
        "symfony/google-mailer": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "CharosEMR\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CharosEMR\\Tests\\": "tests/"
        }
    }
}
